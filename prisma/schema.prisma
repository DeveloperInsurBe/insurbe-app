datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime @default(now())
}

model Application {
  id          String   @id @default(uuid())
  orderId     String
  userId      String?   // null until login
  pdfBase64   String    @db.Text
  status      String    // pending_login | incomplete | completed
  createdAt   DateTime  @default(now())
  personalDetails Json?   
  healthAnswers   Json?   
  uploadedDocs    Json?   
  financialHistory Json?
  insuranceHistory Json?
  signature       String? 
}