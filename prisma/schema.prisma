generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime        @default(now())
  role             String?         @default("user")
  partnerId        String?
  partnerCode      String?         @unique
  companyName      String?
  title            String?
  firstName        String?
  lastName         String?
  /// Custom commission per application in whole EUR; null = role default
  commissionRate   Int?
  partnerProfile   PartnerProfile?
  mawsitaRecords   MawsitaRecord[]
}

model PartnerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  companyName        String?
  title              String?
  firstName          String?
  lastName           String?
  position           String?
  phone              String?
  countryCode        String?
  email              String?
  companyDescription String?
  addressType        String?
  streetName         String?
  streetNumber       String?
  postalCode         String?
  city               String?
  careOfAddress      String?
  country            String?
  accountHolder      String?
  recipientStreet    String?
  recipientZip       String?
  recipientCity      String?
  recipientCountry   String?
  iban               String?
  bicSwift           String?
  accountNumber      String?
  ifscCode           String?
  bankName           String?
  currency           String?
  additionalInfo     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id               String   @id @default(uuid())
  orderId          String
  userId           String?
  pdfBase64        String
  status           String
  createdAt        DateTime @default(now())
  healthAnswers    Json?
  personalDetails  Json?
  signature        String?
  uploadedDocs     Json?
  financialHistory Json?
  insuranceHistory Json?
  startDate        String?
  tariffIds        Json?
  partnerId        String?
  source           String?
  firstName        String?
  lastName         String?
  product          String?
  commission       Int      @default(5)
  commissionStatus String   @default("Pending")
}

/// Default commission per application for a role ("partner" | "agent")
model CommissionDefault {
  role      String   @id
  rate      Int
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

/// Audit log of commission rate changes made in the admin portal
model CommissionRateChange {
  id              String   @id @default(uuid())
  role            String
  /// User id of the partner/agent; null when the role default changed
  userId          String?
  oldRate         Int?
  newRate         Int?
  pendingUpdated  Int      @default(0)
  changedBy       String
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([role, createdAt])
}

model InsuranceApplication {
  id                String    @id @default(cuid())
  provider          String
  status            String    @default("PENDING")
  payload           Json
  createdAt         DateTime? @default(now()) @db.Timestamptz(6)
  applicationNumber String?   @unique
  partnerId         String?
  source            String?

  @@index([partnerId, provider, createdAt])
}

model MawsitaRecord {
  id               String   @id @default(uuid())
  userId           String?
  customerName     String
  email            String
  phone            String?
  planName         String
  planType         String?
  startDate        String?
  endDate          String?
  premiumAmount    Float?
  status           String   @default("Purchased")
  notes            String?
  documents        Json?
  createdByAdminId String?
  createdByEmail   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([email])
  @@index([userId])
}
