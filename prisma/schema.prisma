generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime        @default(now())
  role             String?         @default("user")
  partnerId        String?
  partnerCode      String?         @unique
  companyName      String?
  title            String?
  firstName        String?
  lastName         String?
  partnerProfile   PartnerProfile?
  mawsitaRecords   MawsitaRecord[]
}

model PartnerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  companyName        String?
  title              String?
  firstName          String?
  lastName           String?
  position           String?
  phone              String?
  countryCode        String?
  email              String?
  companyDescription String?
  addressType        String?
  streetName         String?
  streetNumber       String?
  postalCode         String?
  city               String?
  careOfAddress      String?
  country            String?
  accountHolder      String?
  recipientStreet    String?
  recipientZip       String?
  recipientCity      String?
  recipientCountry   String?
  iban               String?
  bicSwift           String?
  currency           String?
  additionalInfo     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id               String   @id @default(uuid())
  orderId          String
  userId           String?
  pdfBase64        String
  status           String
  createdAt        DateTime @default(now())
  healthAnswers    Json?
  personalDetails  Json?
  signature        String?
  uploadedDocs     Json?
  financialHistory Json?
  insuranceHistory Json?
  startDate        String?
  tariffIds        Json?
  partnerId        String?
  source           String?
  firstName        String?
  lastName         String?
  product          String?
  commission       Int      @default(5)
  commissionStatus String   @default("Pending")
}

model InsuranceApplication {
  id                String    @id @default(cuid())
  provider          String
  status            String    @default("PENDING")
  payload           Json
  createdAt         DateTime? @default(now()) @db.Timestamptz(6)
  applicationNumber String?   @unique
}

model MawsitaRecord {
  id               String   @id @default(uuid())
  userId           String?
  customerName     String
  email            String
  phone            String?
  planName         String
  planType         String?
  startDate        String?
  endDate          String?
  premiumAmount    Float?
  status           String   @default("Purchased")
  notes            String?
  documents        Json?
  createdByAdminId String?
  createdByEmail   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([email])
  @@index([userId])
}
